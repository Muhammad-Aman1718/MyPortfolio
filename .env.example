# Copy to .env.local and fill in. .env.local is git-ignored; set the same values on your host (e.g. Vercel).

# PostHog analytics (Project settings → Project token). Leave empty to disable analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: public host of your Cloudflare R2 custom domain for article images, e.g. images.muhammad-aman.com
# (host only, no https://). Leave empty to use local images from /public only.
NEXT_PUBLIC_IMAGE_HOST=

# Optional: set to true to preview draft posts and papers locally. Never set this in production.
SHOW_DRAFTS=
